        {
          "atomType": "GitHubMolecule",
          "x": 0.2577621558289397,
          "y": 0.12944162436548223,
          "uniqueID": "id-1328",
          "name": "Nosecone_Haack_Series",
          "ioValues": [
            {
              "name": "C",
              "ioValue": 0,
              "currentEquation": "0"
            },
